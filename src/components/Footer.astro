---
import Wordmark from './Wordmark.astro';
import { nav, url } from '../site';

const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap">
    <div class="ftr__in">
      <div>
        <Wordmark />
        <p class="mu" style="margin-top: var(--s-snug); font-size: .9375rem; max-width: 26em;">
          A personal finance app for iOS and Android. Everything it knows about your money, it
          knows on your phone.
        </p>
      </div>
      <nav class="ftr__nav" aria-label="Footer">
        {nav.map(item => <a href={url(item.href)}>{item.label}</a>)}
      </nav>
    </div>
    <p class="ftr__fine">
      © {year} Wealth-it. No cookies on this site, and no analytics — there is nothing here
      that would know you came.
    </p>
  </div>
</footer>
