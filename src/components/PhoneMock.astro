---
/**
 * The dashboard, drawn.
 *
 * It is one inline SVG on a 390×844 viewBox — the app's own stage — rather than a screenshot,
 * for two reasons. A screenshot of a simulator is a picture of a machine; this is the real
 * palette, the real type and the real geometry, read out of `tokens.ts`, so it follows the
 * reader into dark mode the way the app follows them into it. And it weighs a few kilobytes
 * with no request attached, which is the argument the site is making in the first place.
 *
 * The figures are the app's demo data, not anybody's money.
 *
 * When there are real screenshots of a real build, they belong here in its place — this is a
 * drawing of the app, and a drawing should never outstay the thing it stands in for.
 */
---

<figure class="mock" aria-label="The Wealth-it dashboard: a total balance of 48,320.75 dirhams, one wallet card, a donut of this month's spending, and the three most recent transactions.">
  <svg viewBox="0 0 390 844" role="img" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <clipPath id="stage"><rect x="0" y="0" width="390" height="844" rx="44" /></clipPath>
    </defs>

    <rect x="0" y="0" width="390" height="844" rx="44" fill="var(--bg)" />
    <rect x=".5" y=".5" width="389" height="843" rx="43.5" fill="none" stroke="var(--ln)" />

    <g clip-path="url(#stage)">
      <!-- status bar -->
      <text x="28" y="45" font-size="13" font-weight="600" fill="var(--tx)">9:41</text>
      <g fill="var(--tx)" opacity=".75">
        <rect x="316" y="35" width="3" height="7" rx="1.5" />
        <rect x="322" y="32" width="3" height="10" rx="1.5" />
        <rect x="328" y="29" width="3" height="13" rx="1.5" />
        <rect x="338" y="31" width="20" height="11" rx="3.5" opacity=".35" />
        <rect x="340" y="33" width="13" height="7" rx="2" />
      </g>

      <!-- balance hero -->
      <text x="24" y="104" font-size="13" font-weight="600" fill="var(--mu)">Total balance</text>
      <text x="24" y="152" font-size="44" font-weight="700" letter-spacing="-1.3" fill="var(--tx)">48,320<tspan
            font-size="22" font-weight="600" letter-spacing="-.4" fill="var(--mu)">.75</tspan></text>
      <text x="24" y="180" font-size="13" fill="var(--inc-t)">+2,140.00 this month</text>

      <!-- wallet carousel: one card, and the edge of the next -->
      <g>
        <rect x="24" y="200" width="242" height="112" rx="20" fill="var(--sf)" stroke="var(--ln)" />
        <rect x="40" y="216" width="36" height="36" rx="12" fill="var(--tint)" />
        <path d="M48 230.5h20v12h-20zM48 230.5v-2.5h16" fill="none" stroke="var(--tx)" stroke-width="1.6"
              stroke-linecap="round" stroke-linejoin="round" opacity=".8" />
        <text x="88" y="230" font-size="14" font-weight="600" fill="var(--tx)">Emirates NBD</text>
        <text x="88" y="247" font-size="12" fill="var(--mu)">Bank · AED</text>
        <text x="40" y="288" font-size="19" font-weight="600" letter-spacing="-.4" fill="var(--tx)">32,104.20</text>
        <polyline points="176,286 187,281 198,284 209,274 220,277 231,268 242,262 250,256"
                  fill="none" stroke="var(--inc)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <!-- the next card, cut by the edge of the phone the way the carousel cuts it -->
        <rect x="286" y="200" width="242" height="112" rx="20" fill="var(--sf)" stroke="var(--ln)" opacity=".7" />
        <rect x="302" y="216" width="36" height="36" rx="12" fill="var(--tint)" opacity=".7" />
      </g>

      <!-- where it went -->
      <rect x="24" y="332" width="342" height="196" rx="20" fill="var(--sf)" stroke="var(--ln)" />
      <text x="44" y="364" font-size="15" font-weight="600" fill="var(--tx)">Where it went</text>
      <g>
        <rect x="266" y="348" width="80" height="26" rx="13" fill="var(--sf2)" />
        <text x="306" y="365" font-size="12" font-weight="500" fill="var(--mu)" text-anchor="middle">This month</text>
      </g>

      <!-- donut: the largest slice always takes the accent, as it does in the app -->
      <g transform="rotate(-90 106 452)" fill="none" stroke-width="14" pathLength="100">
        <circle cx="106" cy="452" r="44" stroke="var(--ln)" stroke-width="14" pathLength="100" />
        <circle cx="106" cy="452" r="44" stroke="#C8F24E" pathLength="100" stroke-dasharray="36.5 63.5" stroke-dashoffset="0" />
        <circle cx="106" cy="452" r="44" stroke="#D9A066" pathLength="100" stroke-dasharray="22.5 77.5" stroke-dashoffset="-38" />
        <circle cx="106" cy="452" r="44" stroke="#6FA8B8" pathLength="100" stroke-dasharray="16.5 83.5" stroke-dashoffset="-61" />
        <circle cx="106" cy="452" r="44" stroke="#8E9BC4" pathLength="100" stroke-dasharray="11.5 88.5" stroke-dashoffset="-78" />
        <circle cx="106" cy="452" r="44" stroke="#8A918D" pathLength="100" stroke-dasharray="8.5 91.5" stroke-dashoffset="-90" />
      </g>
      <text x="106" y="450" font-size="17" font-weight="600" letter-spacing="-.4" fill="var(--tx)" text-anchor="middle">12,480</text>
      <text x="106" y="468" font-size="12" fill="var(--mu)" text-anchor="middle">spent</text>

      <!-- legend -->
      <g font-size="13">
        <circle cx="186" cy="411" r="4" fill="#C8F24E" />
        <text x="198" y="415" fill="var(--tx)">Groceries</text>
        <text x="346" y="415" fill="var(--mu)" text-anchor="end">37%</text>

        <circle cx="186" cy="438" r="4" fill="#D9A066" />
        <text x="198" y="442" fill="var(--tx)">Dining</text>
        <text x="346" y="442" fill="var(--mu)" text-anchor="end">23%</text>

        <circle cx="186" cy="465" r="4" fill="#6FA8B8" />
        <text x="198" y="469" fill="var(--tx)">Transport</text>
        <text x="346" y="469" fill="var(--mu)" text-anchor="end">17%</text>

        <circle cx="186" cy="492" r="4" fill="#8E9BC4" />
        <text x="198" y="496" fill="var(--tx)">Housing</text>
        <text x="346" y="496" fill="var(--mu)" text-anchor="end">12%</text>
      </g>

      <!-- recent -->
      <text x="24" y="566" font-size="15" font-weight="600" fill="var(--tx)">Recent</text>
      <text x="366" y="566" font-size="13" fill="var(--acc-t)" text-anchor="end">See all</text>

      <rect x="24" y="582" width="342" height="186" rx="20" fill="var(--sf)" stroke="var(--ln)" />

      <g>
        <rect x="40" y="598" width="36" height="36" rx="12" fill="#9BB86A" opacity=".18" />
        <text x="88" y="614" font-size="14" font-weight="600" fill="var(--tx)">Carrefour</text>
        <text x="88" y="631" font-size="12" fill="var(--mu)">Groceries · Emirates NBD · 18:40</text>
        <text x="350" y="620" font-size="15" font-weight="600" fill="var(--exp-t)" text-anchor="end">−184.60</text>
      </g>
      <line x1="40" y1="644" x2="350" y2="644" stroke="var(--ln)" />
      <g>
        <rect x="40" y="660" width="36" height="36" rx="12" fill="#4ADE80" opacity=".18" />
        <text x="88" y="676" font-size="14" font-weight="600" fill="var(--tx)">September salary</text>
        <text x="88" y="693" font-size="12" fill="var(--mu)">Salary · Emirates NBD · 09:02</text>
        <text x="350" y="682" font-size="15" font-weight="600" fill="var(--inc-t)" text-anchor="end">+18,000.00</text>
      </g>
      <line x1="40" y1="706" x2="350" y2="706" stroke="var(--ln)" />
      <g>
        <rect x="40" y="722" width="36" height="36" rx="12" fill="#8A918D" opacity=".18" />
        <text x="88" y="738" font-size="14" font-weight="600" fill="var(--tx)">To Savings</text>
        <text x="88" y="755" font-size="12" fill="var(--mu)">Transfer · 2,500.00 · 08:55</text>
        <text x="350" y="744" font-size="15" font-weight="600" fill="var(--mu)" text-anchor="end">↔</text>
      </g>

      <!-- the bar and the button, floating: a blurred pill of five tabs, the FAB beside it -->
      <rect x="16" y="762" width="284" height="62" rx="31" fill="var(--sf)" stroke="var(--ln)" />
      <rect x="24.4" y="777" width="40" height="32" rx="12" fill="var(--acc)" opacity=".16" />
      <path d="M44.4 786.4l7.3 6.6V801a1 1 0 0 1-1 1H38.1a1 1 0 0 1-1-1v-8z" fill="var(--acc-t)" />
      <g stroke="var(--mu)" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <rect x="94.7" y="787" width="13" height="13" rx="2.5" />
        <path d="M98 784.5v3M104.4 784.5v3M94.7 791.5h13" />
        <path d="M154 800v-5M158 800v-9.5M162 800v-7" />
        <rect x="208.3" y="788" width="13" height="10" rx="2.5" />
        <path d="M208.3 791.5h13" />
        <path d="M266 789h11M266 793.5h11M266 798h7" />
      </g>
      <circle cx="343" cy="793" r="31" fill="var(--acc)" />
      <path d="M343 781v24M331 793h24" stroke="#0B0D0C" stroke-width="2.6" stroke-linecap="round" />
    </g>
  </svg>
</figure>

<style>
  .mock {
    margin: 0;
    width: min(340px, 100%);
    justify-self: center;
  }
  .mock svg {
    width: 100%;
    height: auto;
    font-family: var(--font);
    font-variant-numeric: tabular-nums;
  }
</style>
