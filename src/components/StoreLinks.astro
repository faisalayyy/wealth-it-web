---
/**
 * The download row, or the honest absence of one.
 *
 * Until `stores.ios` and `stores.android` are real, this renders what is true — that the app is
 * not in either store yet — instead of a button that goes nowhere or a badge that implies a
 * listing. An app whose whole pitch is that it does not quietly do things behind your back
 * cannot open with a link that quietly does not work.
 */
import Icon from './Icon.astro';
import { stores, url } from '../site';

interface Props {
  /** The two links a page offers while there is nothing to download. */
  fallbackPrimary?: { href: string; label: string };
  fallbackSecondary?: { href: string; label: string };
  center?: boolean;
}
const {
  fallbackPrimary = { href: url('/features/'), label: 'What it does' },
  fallbackSecondary = { href: url('/privacy/'), label: 'Where the data lives' },
  center = false,
} = Astro.props;

const live = Boolean(stores.ios || stores.android);
---

<div class="cta">
  <div class={center ? 'row row--center' : 'row'}>
    {live ? (
      <>
        {stores.ios && (
          <a class="btn btn--primary" href={stores.ios}>
            <Icon name="download" class="btn__icon" /> Download for iPhone
          </a>
        )}
        {stores.android && (
          <a class="btn btn--quiet" href={stores.android}>
            <Icon name="download" class="btn__icon" /> Get it on Android
          </a>
        )}
      </>
    ) : (
      <>
        <a class="btn btn--primary" href={fallbackPrimary.href}>
          {fallbackPrimary.label} <Icon name="arrow" class="btn__icon btn__arrow" />
        </a>
        <a class="btn btn--quiet" href={fallbackSecondary.href}>{fallbackSecondary.label}</a>
      </>
    )}
  </div>

  {!live && (
    <p class={center ? 'cta__note cta__note--center' : 'cta__note'}>
      <span class="pill"><span class="pill__dot" aria-hidden="true"></span>Not in the stores yet</span>
      <span>iOS and Android. The links will be here on the day they are real.</span>
    </p>
  )}
</div>

<style>
  .cta__note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-snug);
    margin: var(--s-gap) 0 0;
    font-size: .875rem;
    color: var(--mu);
    max-width: none;
  }
  .cta__note--center { justify-content: center; }
</style>
