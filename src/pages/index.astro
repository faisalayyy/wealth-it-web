---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PhoneMock from '../components/PhoneMock.astro';
import StoreLinks from '../components/StoreLinks.astro';
import { site, url } from '../site';

const questions = [
  {
    q: 'Where do I stand?',
    a: 'Every wallet and the total, as of this second. Balances are worked out from what you recorded rather than stored anywhere, so there is no cached figure to drift out of date.',
  },
  {
    q: 'Where did the money go?',
    a: 'Spending by category, subcategory, wallet or label, over a week, a month, a year or a stretch of dates you pick yourself.',
  },
  {
    q: 'Am I on plan?',
    a: 'A budget per category, weekly or monthly, and savings targets that know how far along they are. The bar tells you before it is full, not after.',
  },
  {
    q: 'What is coming?',
    a: 'Rent on the 1st, salary on the 25th, insurance in March. Scheduled payments post themselves once and exactly once, and sit ahead of you where you can see them.',
  },
];

const features = [
  {
    icon: 'wallet',
    title: 'Six kinds of wallet',
    body: 'Cash, bank, credit card, savings, loan, investment. The type decides which fields exist and which side of the ledger the balance falls on — a credit card counts against you, not for you.',
  },
  {
    icon: 'swap',
    title: 'Transfers that stay transfers',
    body: 'Expense, income, transfer. Moving your own money between two wallets is not spending, and no total, chart or budget on the screen will treat it as if it were.',
  },
  {
    icon: 'chart',
    title: 'Budgets per category',
    body: 'Weekly or monthly, set in one screen with the planned total adding up live at the top. Leave one blank and it is not a budget of zero — it is simply not a budget.',
  },
  {
    icon: 'calendar',
    title: 'Scheduled payments',
    body: 'Set the recurrence once. Each occurrence has its own identity, so the same rent can never be posted twice, however many times the app is opened.',
  },
  {
    icon: 'donut',
    title: 'Statistics worth the scroll',
    body: 'Balance over time, spending by category, cashflow in and out, and where the credit cards stand. Anything projected is labelled as a projection and kept out of the confirmed figures.',
  },
  {
    icon: 'globe',
    title: 'More than one currency',
    body: 'Currency belongs to the wallet, so no form ever asks you for it. Nothing is converted at a rate the app invented — see below.',
  },
] as const;

const absent = [
  {
    title: 'No sync between devices',
    body: 'Two phones would be two separate ledgers. Syncing them means a server in the middle, and the server is the thing this app does not have.',
  },
  {
    title: 'No bank connections',
    body: 'Nothing to link, nothing to authorise, and no third party holding read access to your account on your behalf. Records are yours to enter, which takes about four seconds.',
  },
  {
    title: 'No ads and no upsell',
    body: 'Nothing is behind a tier, and no screen stops halfway to sell you the rest of itself.',
  },
  {
    title: 'No password reset',
    body: 'There is no password and no account, so there is nothing to reset. The trade is real: a lost phone loses the ledger unless you have saved a backup file somewhere.',
  },
];
---

<Base title={site.name}>
  <!-- ------------------------------------------------------------------ hero -->
  <section class="hero">
    <div class="wrap hero__in">
      <div class="hero__copy">
        <h1 class="hero-title">Know where you stand,<br />without telling anyone.</h1>
        <p class="lede">
          Wealth-it is a personal finance app for iPhone and Android. Wallets, transactions,
          budgets and what is due next month — all of it worked out on the phone in your hand,
          and none of it sent anywhere. There is no account, because there is no server to keep
          one on.
        </p>
        <StoreLinks />
      </div>
      <PhoneMock />
    </div>
  </section>

  <!-- --------------------------------------------------------- four questions -->
  <section class="section--ruled">
    <div class="wrap">
      <p class="eyebrow">What it is for</p>
      <h2>Four questions, in the order people actually ask them.</h2>
      <p class="lede" style="margin-top: var(--s-gap);">
        Everything in the app is arranged around these. Open it and the first one is answered
        before your thumb has moved.
      </p>

      <div class="rule-list" style="margin-top: var(--s-page);">
        {questions.map((item, i) => (
          <div>
            <span class="rule-list__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------- feature grid -->
  <section class="section--sunk">
    <div class="wrap">
      <p class="eyebrow">What is in it</p>
      <h2>Built around a ledger, not a dashboard.</h2>
      <p class="lede" style="margin-top: var(--s-gap);">
        Every figure on every screen is derived from your transactions and your opening balances.
        Nothing is cached, so nothing can quietly disagree with anything else.
      </p>

      <div class="grid" style="margin-top: var(--s-page);">
        {features.map(f => (
          <article class="card">
            <span class="card__mark"><Icon name={f.icon} /></span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))}
      </div>

      <p class="row" style="margin-top: var(--s-block);">
        <a class="btn btn--quiet" href={url('/features/')}>
          All of it, in detail <Icon name="arrow" class="btn__arrow" />
        </a>
      </p>
    </div>
  </section>

  <!-- ------------------------------------------------------------------ rates -->
  <section class="section--ruled">
    <div class="wrap split">
      <div>
        <p class="eyebrow">One rule worth reading</p>
        <h2>It will not invent an exchange rate.</h2>
      </div>
      <div class="stack">
        <p>
          Most apps convert your money using whatever rate they happened to fetch, and the
          converted figure then sits in the same total as the ones you actually recorded, looking
          exactly as solid.
        </p>
        <p>
          Wealth-it treats a rate as something it works out, not something it downloads. It uses
          a cross-currency transfer you made yourself — you moved money between two wallets, so
          you set the rate — or the published AED/USD peg. If a figure cannot be converted
          honestly, it is left out of the total, named, and still shown in its own currency.
        </p>
        <p class="mu">
          An estimate is always marked as one and never shares a number with a fact.
        </p>
      </div>
    </div>
  </section>

  <!-- ---------------------------------------------------------------- privacy -->
  <section class="section--sunk">
    <div class="wrap">
      <p class="eyebrow">Where the data lives</p>
      <h2>On the phone. That is the whole of it.</h2>

      <ul class="claims" style="margin-top: var(--s-page);">
        <li><Icon name="check" /><span><strong>No account and no sign-in.</strong> Install it and start; there is nobody to be.</span></li>
        <li><Icon name="check" /><span><strong>No server.</strong> Nothing to breach, nothing to subpoena, nothing to keep running once you have stopped paying attention.</span></li>
        <li><Icon name="check" /><span><strong>No analytics and no crash reporting.</strong> Nobody, including whoever wrote it, knows you opened it today.</span></li>
        <li><Icon name="check" /><span><strong>Nothing leaves except what you export.</strong> A backup file or a CSV, saved where you choose, when you ask for it.</span></li>
      </ul>

      <p class="row" style="margin-top: var(--s-block);">
        <a class="btn btn--quiet" href={url('/privacy/')}>
          The privacy page, at length <Icon name="arrow" class="btn__arrow" />
        </a>
      </p>
    </div>
  </section>

  <!-- ------------------------------------------------------------- what it isn't -->
  <section class="section--ruled">
    <div class="wrap">
      <p class="eyebrow eyebrow--mu">And what it does not do</p>
      <h2>The things that are missing are missing on purpose.</h2>

      <div class="grid grid--2" style="margin-top: var(--s-page);">
        {absent.map(a => (
          <article class="card">
            <h3>{a.title}</h3>
            <p>{a.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------------- close -->
  <section class="section--sunk center">
    <div class="wrap wrap--narrow">
      <h2>One person, one phone, one ledger.</h2>
      <p class="lede lede--center" style="margin-top: var(--s-gap);">
        That is the whole design, and everything else follows from it.
      </p>
      <div style="margin-top: var(--s-block);">
        <StoreLinks center fallbackSecondary={{ href: url('/support/'), label: 'Read the help first' }} />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(40px, 6vw, 88px) var(--s-page); }
  .hero__in {
    display: grid;
    gap: clamp(40px, 6vw, 72px);
    align-items: center;
  }
  .hero__copy .lede { margin-top: var(--s-block); }
  .hero__copy :global(.cta) { margin-top: var(--s-section); }

  @media (min-width: 900px) {
    .hero__in { grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); }
  }

  .split { display: grid; gap: var(--s-block); }
  @media (min-width: 860px) {
    .split { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(40px, 5vw, 80px); }
  }

  .claims { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-gap); max-width: 46em; }
  .claims li { display: flex; gap: var(--s-snug); align-items: flex-start; line-height: 1.55; }
  .claims :global(svg) { width: 20px; height: 20px; flex: none; margin-top: 3px; color: var(--acc-t); }
  .claims strong { font-weight: 600; }
  .claims span { color: var(--mu); }
  .claims strong { color: var(--tx); }
</style>
