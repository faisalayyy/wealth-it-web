---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { contactEmail } from '../site';

/**
 * The support page, and the URL the App Store asks for.
 *
 * It answers first and offers an address second: almost every question about the app is one the
 * page can settle faster than a reply could.
 */
const faqs = [
  {
    q: 'I got a new phone. How do I move my records across?',
    a: [
      'Install Wealthit on the new phone and sign in the way you signed in before — Apple, Google, or your email. Everything you recorded comes down from your account.',
      'Receipt photos and your profile picture stay on the old phone, because they are never uploaded.',
    ],
  },
  {
    q: 'I lost my phone. What can be recovered?',
    a: [
      'Everything you recorded, as of the last time the phone was online. Sign in on any phone and it is there.',
      'If you had an app lock on the lost phone, the records on it stay behind that lock.',
    ],
  },
  {
    q: 'Can I use Wealthit on two phones?',
    a: [
      'Yes. Sign in to the same account on both and they show the same money. A record made offline goes up as soon as that phone is back online.',
    ],
  },
  {
    q: 'I did not get the sign-in email.',
    a: [
      'Check spam and other folders, and that the address is spelt right. The email comes from no-reply@wealthit.app and its link and code last ten minutes.',
      'You can also sign in with Apple or Google, or set a password in your profile so email is never needed.',
    ],
  },
  {
    q: 'I have forgotten my app lock PIN.',
    a: [
      'After two wrong tries, the lock screen offers to log you out. Sign in again with Apple, Google or your email, and your records come back from your account. The old PIN is removed, so you can set a new one in Advanced settings → Security.',
      'If you also turned on Face ID for the lock, Face ID still opens the app.',
    ],
  },
  {
    q: 'How do I delete my account?',
    a: [
      'Open your profile and choose Delete account. You are signed out everywhere and the phone is cleared, and 60 days later the account and everything in it are deleted for good. Sign in before then to change your mind.',
      'To have it deleted straight away, write to the address below from the email you sign in with.',
    ],
  },
  {
    q: 'A figure is missing from my total, and the app says so.',
    a: [
      'That is an amount in a currency the app could not convert. It uses a rate you got yourself on a transfer between two of your wallets, a published peg such as AED to the dollar, or the day\'s published rate. It never guesses.',
      'If daily rates are switched off in Currency & format, switching them on usually settles it. Until then the amount is shown in its own currency rather than folded into a total that would be wrong.',
    ],
  },
  {
    q: 'My transfer is not showing up in spending.',
    a: [
      'It should not. Moving your own money from one wallet to another is not an expense, and no total, chart or budget in the app treats it as one. Both halves of it appear in the wallets themselves.',
    ],
  },
  {
    q: 'Did my scheduled payment post twice?',
    a: [
      'It cannot. Each occurrence takes its identity from its schedule and its date, so the same rent on the same first of the month is the same record however many times the app is opened, on however many phones.',
      'If you are seeing two, one of them was almost certainly entered by hand. Open both and check the times.',
    ],
  },
  {
    q: 'Reminders are not arriving.',
    a: [
      'Check the phone\'s own notification settings for Wealthit. Reminders are scheduled on the phone and the app can only ask — if the system refuses, the screen in the app says so rather than claiming it worked.',
    ],
  },
  {
    q: 'What is the difference between hiding amounts and locking the app?',
    a: [
      'Hiding amounts scrambles the digits on screen so the person next to you cannot read them. It is privacy, not security, and the data underneath is untouched.',
      'The app lock is a PIN or Face ID, and it keeps the app closed.',
    ],
  },
];
---

<Base
  title="Support"
  description="New phones, sign-in, currencies that will not convert, and the rest of the questions Wealthit gets — answered on one page, with an address at the bottom."
>
  <section>
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Support</p>
      <h1 class="hero-title">Most of it is answered here.</h1>
      <p class="lede" style="margin-top: var(--s-block);">
        Most questions have a short answer, and it is probably below. The address is at the
        bottom for everything else.
      </p>
    </div>
  </section>

  <section class="section--ruled">
    <div class="wrap wrap--narrow">
      <div class="faq">
        {faqs.map(item => (
          <details class="faq__item">
            <summary>
              <span>{item.q}</span>
              <Icon name="arrow" class="faq__chev" />
            </summary>
            <div class="faq__a">
              {item.a.map(p => <p>{p}</p>)}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section--sunk">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Still stuck</p>
      <h2>Write, and say what happened.</h2>
      <p class="lede" style="margin-top: var(--s-gap);">
        One person reads this address, so a reply takes as long as it takes. What makes it
        quicker:
      </p>
      <ul class="ticks" style="margin-top: var(--s-block);">
        <li><Icon name="check" /><span>The phone, and the version of Wealthit — it is in Advanced settings → About Wealthit.</span></li>
        <li><Icon name="check" /><span>What you did, what you expected, and what happened instead.</span></li>
        <li><Icon name="check" /><span>A screenshot, if there is anything to see. Hide the amounts first if you would rather.</span></li>
      </ul>
      <p class="row" style="margin-top: var(--s-block);">
        <a class="btn btn--primary" href={`mailto:${contactEmail}`}>{contactEmail}</a>
      </p>
      <p class="mu" style="margin-top: var(--s-gap); font-size: .875rem;">
        Please do not send a backup file unless you have been asked for one — it holds every
        record you have made, and email is not the place for it.
      </p>
    </div>
  </section>
</Base>

<style>
  .faq { border-top: 1px solid var(--ln); }
  .faq__item { border-bottom: 1px solid var(--ln); }

  .faq__item summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--s-gap);
    padding-block: var(--s-block);
    cursor: pointer;
    list-style: none;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -.02em;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary:hover { color: var(--acc-t); }

  .faq__item :global(.faq__chev) {
    width: 20px; height: 20px; flex: none;
    margin-top: 3px;
    color: var(--mu);
    transform: rotate(90deg);
    transition: transform var(--t-quick) var(--ease);
  }
  .faq__item[open] :global(.faq__chev) { transform: rotate(-90deg); }

  .faq__a { padding-bottom: var(--s-block); }
  .faq__a p { color: var(--mu); font-size: .9375rem; max-width: 40em; }
  .faq__a p:last-child { margin-bottom: 0; }

  .ticks { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-snug); }
  .ticks li { display: flex; gap: var(--s-snug); align-items: flex-start; color: var(--mu); line-height: 1.5; }
  .ticks :global(svg) { width: 20px; height: 20px; flex: none; margin-top: 3px; color: var(--acc-t); }
</style>
